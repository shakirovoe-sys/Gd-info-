:root{--ink:#10172d;--paper:#f8f4e8;--lime:#d8ff39;--blue:#2f62ff;--pink:#ff4fa3;--orange:#ff8a2a;--line:#10172d;--muted:#5f6472}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.18;background-image:linear-gradient(var(--ink) 1px,transparent 1px),linear-gradient(90deg,var(--ink) 1px,transparent 1px);background-size:36px 36px;mask-image:linear-gradient(to bottom,black,transparent 75%)}
a{color:inherit}.shell{width:min(1180px,calc(100% - 34px));margin:auto;position:relative}.nav{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid var(--line)}
.brand{display:flex;align-items:center;gap:11px;font-weight:950;letter-spacing:-.04em;text-transform:uppercase}.brand-mark{width:30px;height:30px;background:var(--lime);border:2px solid var(--line);box-shadow:4px 4px 0 var(--ink);display:grid;place-items:center}.brand-mark:after{content:"";width:8px;height:8px;background:var(--ink);box-shadow:10px 0 var(--ink)}
.links{display:flex;gap:28px;font-size:.82rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.links a{text-decoration:none}.links a:hover{color:var(--blue)}
.hero{min-height:760px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:60px;padding:70px 0 100px}.eyebrow{font:800 .78rem/1 ui-monospace,SFMono-Regular,monospace;letter-spacing:.12em;text-transform:uppercase;display:flex;align-items:center;gap:10px}.eyebrow:before{content:"";width:38px;height:8px;background:var(--pink);border:2px solid var(--line)}
h1{font-size:clamp(4.2rem,10vw,8.7rem);line-height:.78;letter-spacing:-.085em;text-transform:uppercase;margin:30px 0 35px;font-weight:1000}.outline{color:transparent;-webkit-text-stroke:3px var(--ink)}
.lede{max-width:590px;font-size:1.2rem;line-height:1.55;color:#353b4b}.cta-row{display:flex;align-items:center;gap:18px;margin-top:34px;flex-wrap:wrap}.btn{border:2px solid var(--line);padding:15px 22px;background:var(--lime);box-shadow:6px 6px 0 var(--ink);text-transform:uppercase;text-decoration:none;font-weight:950;letter-spacing:.05em;transition:.18s}.btn:hover{transform:translate(3px,3px);box-shadow:3px 3px 0 var(--ink)}.micro{font:700 .72rem/1.4 ui-monospace,monospace;color:var(--muted);text-transform:uppercase}
.playfield{height:520px;position:relative;border:2px solid var(--line);overflow:hidden;background:var(--blue);box-shadow:14px 14px 0 var(--ink)}.playfield:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 25% 30%,rgba(255,255,255,.26),transparent 2px);background-size:35px 35px;opacity:.7}.sun{width:210px;height:210px;border-radius:50%;position:absolute;right:-20px;top:35px;background:var(--orange);border:3px solid var(--line)}.hills{position:absolute;left:-20%;bottom:74px;width:150%;height:150px;background:var(--pink);clip-path:polygon(0 100%,14% 30%,27% 90%,41% 0,56% 75%,72% 20%,84% 90%,100% 28%,100% 100%);border-top:3px solid var(--line)}.ground{position:absolute;bottom:0;left:0;right:0;height:78px;background:var(--lime);border-top:3px solid var(--line);background-image:linear-gradient(45deg,rgba(16,23,45,.15) 25%,transparent 25%,transparent 75%,rgba(16,23,45,.15) 75%),linear-gradient(45deg,rgba(16,23,45,.15) 25%,transparent 25%,transparent 75%,rgba(16,23,45,.15) 75%);background-size:24px 24px;background-position:0 0,12px 12px}.cube{position:absolute;width:88px;height:88px;left:90px;bottom:125px;background:var(--lime);border:4px solid var(--line);box-shadow:8px 8px 0 rgba(16,23,45,.35);display:grid;place-items:center;animation:jump 2.2s cubic-bezier(.7,0,.3,1) infinite}.face{width:49px;height:40px;border-top:10px solid var(--ink);border-bottom:9px solid var(--ink);position:relative}.face:after{content:"";position:absolute;width:9px;height:9px;background:var(--ink);top:7px;left:4px;box-shadow:26px 0 var(--ink)}.spike{position:absolute;bottom:76px;left:305px;width:72px;height:78px;background:var(--ink);clip-path:polygon(50% 0,100% 100%,0 100%)}.spike.s2{left:370px;height:55px}.hud{position:absolute;top:24px;left:24px;right:24px;display:flex;justify-content:space-between;font:800 .72rem/1 ui-monospace,monospace;color:white;text-transform:uppercase;letter-spacing:.1em}.meter{width:130px;height:9px;border:2px solid white}.meter i{display:block;width:72%;height:100%;background:var(--lime)}
@keyframes jump{0%,12%,100%{transform:translateY(0) rotate(0)}46%,58%{transform:translate(175px,-150px) rotate(180deg)}86%{transform:translate(310px,0) rotate(360deg)}}
section{padding:110px 0;border-top:2px solid var(--line)}.section-head{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end;margin-bottom:65px}.kicker{font:900 .75rem/1 ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--blue)}h2{font-size:clamp(3rem,7vw,6.6rem);line-height:.86;letter-spacing:-.07em;text-transform:uppercase;margin:14px 0 0}.section-head p{font-size:1.05rem;line-height:1.65;color:var(--muted);max-width:500px;margin:0 0 5px auto}
.timeline{display:grid;grid-template-columns:repeat(4,1fr);border:2px solid var(--line);box-shadow:10px 10px 0 var(--pink)}.era{min-height:315px;padding:28px;border-right:2px solid var(--line);background:#fffdf5;position:relative}.era:last-child{border:0}.year{font:950 2.5rem/1 ui-monospace,monospace;color:var(--blue);letter-spacing:-.08em}.era h3{font-size:1.35rem;line-height:1.05;margin:65px 0 14px;text-transform:uppercase}.era p{line-height:1.55;font-size:.92rem;color:var(--muted)}.era:after{content:"";position:absolute;left:28px;top:80px;width:14px;height:14px;background:var(--lime);border:2px solid var(--line);transform:rotate(45deg)}
.players{background:var(--ink);color:white}.players .section-head{border-color:white}.players .section-head p{color:#aeb4c4}.players .kicker{color:var(--lime)}.player-list{border-top:1px solid #4d5365}.player{display:grid;grid-template-columns:70px 1fr 1.2fr auto;gap:25px;align-items:center;padding:26px 0;border-bottom:1px solid #4d5365;transition:.2s}.player:hover{padding-left:14px;background:rgba(255,255,255,.04)}.rank{font:900 1.7rem/1 ui-monospace,monospace;color:var(--lime)}.player-name{font-size:clamp(1.7rem,4vw,3.3rem);font-weight:950;letter-spacing:-.05em;text-transform:uppercase}.player p{margin:0;color:#aeb4c4;line-height:1.45}.tag{font:800 .7rem/1 ui-monospace,monospace;text-transform:uppercase;letter-spacing:.08em;border:1px solid #70778b;padding:9px 11px;color:var(--pink)}
.modes{display:grid;grid-template-columns:1.2fr .8fr;gap:30px}.big-card,.small-card{border:2px solid var(--line);background:white;padding:34px;min-height:310px;position:relative;overflow:hidden}.big-card{background:var(--lime);box-shadow:10px 10px 0 var(--blue)}.card-num{font:950 7rem/.8 ui-monospace,monospace;letter-spacing:-.1em;opacity:.16;position:absolute;right:20px;top:24px}.big-card h3,.small-card h3{font-size:2.2rem;text-transform:uppercase;letter-spacing:-.05em;margin:135px 0 10px}.big-card p,.small-card p{max-width:520px;color:#42485a;line-height:1.55}.stack{display:grid;gap:30px}.small-card{min-height:140px;padding:28px}.small-card h3{font-size:1.45rem;margin:10px 0}.small-card.pink{background:var(--pink)}.small-card.blue{background:var(--blue);color:white}.small-card.blue p{color:#d9e0ff}
.quote{padding:110px 0;text-align:center}.quote p{font-size:clamp(2.4rem,6vw,5.8rem);line-height:.96;font-weight:950;letter-spacing:-.06em;text-transform:uppercase;margin:0 auto;max-width:1000px}.quote em{font-style:normal;color:var(--blue)}
footer{border-top:2px solid var(--line);padding:34px 0 60px}.footer-row{display:flex;justify-content:space-between;gap:20px;align-items:center}.fine{font-size:.75rem;line-height:1.5;color:var(--muted);max-width:680px}.source-links{display:flex;gap:16px;font:800 .72rem/1 ui-monospace,monospace;text-transform:uppercase}.source-links a:hover{color:var(--blue)}
.reveal{opacity:0;transform:translateY(24px);transition:.7s ease}.reveal.on{opacity:1;transform:none}
@media(max-width:850px){.links{display:none}.hero{grid-template-columns:1fr;min-height:auto;padding-top:55px}.playfield{height:400px}.section-head{grid-template-columns:1fr}.section-head p{margin:0}.timeline{grid-template-columns:1fr 1fr}.era:nth-child(2){border-right:0}.era:nth-child(-n+2){border-bottom:2px solid var(--line)}.player{grid-template-columns:46px 1fr}.player p,.tag{grid-column:2}.modes{grid-template-columns:1fr}.footer-row{align-items:flex-start;flex-direction:column}}@media(max-width:520px){h1{font-size:4.2rem}.playfield{height:340px}.cube{left:30px}.timeline{grid-template-columns:1fr}.era{border-right:0;border-bottom:2px solid var(--line)!important}.era:last-child{border-bottom:0!important}.player{gap:12px}.source-links{flex-wrap:wrap}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}.cube{animation:none}.reveal{opacity:1;transform:none}}
